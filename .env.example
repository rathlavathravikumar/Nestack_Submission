# Set a private random secret. Do not commit or expose it in client code.
REVALIDATION_SECRET=

# Optional global flag to simulate invalidation failure in Server Action
SIMULATE_INVALIDATION_FAILURE=false

# PostgreSQL connection. The application uses PostgreSQL when this is set;
# leave blank to use local JSON storage during development.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_SIZE=5
